<div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-12">
  <div class="rounded-2xl bg-slate-800/80 border border-slate-700 p-8 shadow-2xl">
    <div class="border-b border-slate-700 pb-6 mb-6">
      <span class="text-xs font-semibold uppercase tracking-wider text-sky-400">KYC Status Record</span>
      <h1 class="text-2xl font-bold text-white mt-1">Verification Status</h1>
    </div>

    <div class="space-y-6">
      <div class="flex items-center justify-between p-4 rounded-xl bg-slate-900/60 border border-slate-700">
        <div>
          <p class="text-sm font-semibold text-white">Current Compliance State</p>
          <p class="text-xs text-slate-400 mt-0.5">Automated KYC check</p>
        </div>
        <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-bold <%= @user.kyc_verified? ? 'bg-emerald-400/10 text-emerald-400 ring-1 ring-emerald-400/20' : 'bg-amber-400/10 text-amber-400 ring-1 ring-amber-400/20' %>">
          <%= @user.kyc_status.upcase %>
        </span>
      </div>

      <div class="text-sm space-y-3">
        <div class="flex justify-between">
          <span class="text-slate-400">Customer Name</span>
          <span class="font-medium text-white"><%= @user.full_name %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Email Address</span>
          <span class="font-medium text-white"><%= @user.email %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Document Attached</span>
          <span class="font-medium text-white"><%= @user.kyc_document.attached? ? "Uploaded & Secured ✓" : "None" %></span>
        </div>
      </div>

      <div class="pt-6 border-t border-slate-700/60 flex items-center justify-between">
        <%= link_to "&larr; Back to Dashboard".html_safe, accounts_path, class: "text-sm text-slate-400 hover:text-white" %>
        <% unless @user.kyc_verified? %>
          <%= link_to "Upload New Document", new_kyc_verification_path, class: "rounded-lg bg-sky-500 px-4 py-2 text-xs font-semibold text-white hover:bg-sky-400" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
