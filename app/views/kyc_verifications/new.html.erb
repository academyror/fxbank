<div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-12">
  <div class="rounded-2xl bg-slate-800/80 border border-slate-700 p-8 shadow-2xl">
    <div class="border-b border-slate-700 pb-6 mb-6">
      <span class="text-xs font-semibold uppercase tracking-wider text-sky-400">Compliance & Regulatory Safety</span>
      <h1 class="text-2xl font-bold text-white mt-1">Identity Verification (KYC)</h1>
      <p class="text-sm text-slate-400 mt-2">
        Financial regulations require identity verification before accounts can process unlimited peer-to-peer transfers.
      </p>
    </div>

    <%= form_with url: kyc_verification_path, method: :post, scope: :user, class: "space-y-6" do |f| %>
      <div>
        <%= f.label :avatar, "Profile Avatar (Optional)", class: "block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2" %>
        <%= f.file_field :avatar, accept: "image/png,image/jpeg,image/webp", class: "block w-full text-sm text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-slate-700 file:text-white hover:file:bg-slate-600 cursor-pointer" %>
        <p class="text-xs text-slate-500 mt-1">Max 5MB (PNG, JPEG, WebP).</p>
      </div>

      <div>
        <%= f.label :kyc_document, "Government Photo ID (Passport or Driver's License)", class: "block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2" %>
        <%= f.file_field :kyc_document, required: true, accept: "application/pdf,image/png,image/jpeg", class: "block w-full text-sm text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-sky-600 file:text-white hover:file:bg-sky-500 cursor-pointer" %>
        <p class="text-xs text-slate-500 mt-1">Max 15MB (PDF, PNG, JPEG). Encrypted at rest in private storage.</p>
      </div>

      <div class="pt-4 flex items-center justify-between border-t border-slate-700/60">
        <%= link_to "Cancel", accounts_path, class: "text-sm text-slate-400 hover:text-white" %>
        <%= f.submit "Upload for Verification", class: "cursor-pointer rounded-lg bg-sky-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-sky-400 shadow-md transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
