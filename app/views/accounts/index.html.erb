<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
  <div class="md:flex md:items-center md:justify-between border-b border-slate-800 pb-6 mb-8">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Accounts Overview</h1>
      <p class="mt-1 text-sm text-slate-400">Welcome back, <%= current_user.full_name %> &bull; <%= current_user.email %></p>
    </div>
    <div class="mt-4 flex md:ml-4 md:mt-0 items-center gap-x-3">
      <span class="inline-flex items-center rounded-md bg-emerald-500/10 px-2.5 py-1 text-xs font-medium text-emerald-400 ring-1 ring-inset ring-emerald-500/20">
        KYC <%= current_user.kyc_status.capitalize %>
      </span>
      <span class="inline-flex items-center rounded-md bg-sky-500/10 px-2.5 py-1 text-xs font-medium text-sky-400 ring-1 ring-inset ring-sky-500/20">
        Role: <%= current_user.role.titleize %>
      </span>
    </div>
  </div>

  <!-- Summary Card -->
  <div class="rounded-2xl bg-gradient-to-tr from-slate-800 via-slate-800/80 to-slate-900 p-8 ring-1 ring-white/10 mb-10 shadow-xl">
    <p class="text-sm font-medium text-slate-400">Total Net Portfolio Balance</p>
    <p class="mt-2 text-4xl font-extrabold text-white tracking-tight">
      $<%= format("%.2f", (@total_balance_cents || 0) / 100.0) %> <span class="text-sm font-normal text-slate-400">USD</span>
    </p>
    <p class="mt-2 text-xs text-slate-400">Aggregated across <%= @accounts.count %> active accounts</p>
  </div>

  <!-- Accounts Grid -->
  <h2 class="text-lg font-semibold text-white mb-4">Your Financial Accounts</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @accounts.each do |account| %>
      <div class="rounded-xl bg-slate-800/80 p-6 ring-1 ring-white/10 flex flex-col justify-between hover:ring-sky-500/30 transition-all shadow-md">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-sky-400 uppercase tracking-wider">
              <%= account.currency %> Account
            </span>
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= account.active? ? 'bg-emerald-400/10 text-emerald-400 ring-1 ring-inset ring-emerald-400/20' : 'bg-rose-400/10 text-rose-400 ring-1 ring-inset ring-rose-400/20' %>">
              <%= account.status.capitalize %>
            </span>
          </div>

          <div class="mt-4 flex items-center justify-between" data-controller="clipboard">
            <p class="text-xs text-slate-400 font-mono" data-clipboard-target="source"><%= account.account_number %></p>
            <button type="button" data-action="click->clipboard#copy" data-clipboard-target="button" class="text-xs text-sky-400 hover:text-sky-300 font-medium">
              Copy Number
            </button>
          </div>

          <p class="mt-4 text-3xl font-bold text-white tracking-tight" id="account_balance_<%= account.id %>">
            <%= account.formatted_balance %>
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-700/60 flex items-center justify-between">
          <%= link_to "View Statement &rarr;".html_safe, account_path(account), class: "text-sm font-medium text-sky-400 hover:text-sky-300" %>
          <%= link_to "Send Money", new_account_transfer_path(account), data: { turbo_frame: "transfer_modal" }, class: "rounded-md bg-sky-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-sky-500" %>
        </div>
      </div>
    <% end %>
  </div>

  <turbo-frame id="transfer_modal"></turbo-frame>
</div>
