<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
  <div class="mb-6">
    <%= link_to "&larr; Back to Accounts Overview".html_safe, accounts_path, class: "text-sm text-slate-400 hover:text-white" %>
  </div>

  <div class="rounded-2xl bg-slate-800/80 p-8 ring-1 ring-white/10 mb-10">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold text-white"><%= @account.account_number %></h1>
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold <%= @account.active? ? 'bg-emerald-400/10 text-emerald-400 ring-1 ring-emerald-400/20' : 'bg-rose-400/10 text-rose-400 ring-1 ring-rose-400/20' %>">
            <%= @account.status.capitalize %>
          </span>
        </div>
        <p class="mt-1 text-sm text-slate-400">Currency: <%= @account.currency %> &bull; Owner: <%= @account.user.full_name %></p>
      </div>

      <div class="flex items-center gap-4">
        <div class="text-right">
          <p class="text-xs text-slate-400">Available Balance</p>
          <p class="text-3xl font-extrabold text-white" id="account_balance_<%= @account.id %>">
            <%= @account.formatted_balance %>
          </p>
        </div>
        <% if @account.active? %>
          <%= link_to "Send Money", new_account_transfer_path(@account), data: { turbo_frame: "transfer_modal" }, class: "rounded-lg bg-sky-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-sky-400 shadow-md transition-colors" %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Turbo Frame for Inline Modal -->
  <turbo-frame id="transfer_modal"></turbo-frame>

  <!-- Transaction History Ledger -->
  <div class="rounded-2xl bg-slate-800/40 p-6 ring-1 ring-white/10">
    <div class="flex items-center justify-between border-b border-slate-700/60 pb-4 mb-6">
      <h2 class="text-xl font-bold text-white">Transaction Ledger</h2>
      <span class="text-xs text-slate-400">Real-time audited transfers</span>
    </div>

    <div class="flow-root">
      <ul role="list" id="transfers_list" class="divide-y divide-slate-800">
        <% if @transfers.any? %>
          <% @transfers.each do |transfer| %>
            <%= render "transfers/transfer", transfer: transfer, current_account: @account %>
          <% end %>
        <% else %>
          <li class="py-12 text-center text-sm text-slate-500" id="no_transfers_empty_state">
            No transactions recorded yet for this account.
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
