<%# locals: (transfer:, current_account: nil) %>
<% is_debit = current_account ? transfer.from_account_id == current_account.id : (defined?(current_user) && transfer.from_account.user_id == current_user.id) %>

<li class="py-4 flex items-center justify-between hover:bg-slate-800/30 px-3 rounded-lg transition-colors" id="transfer_<%= transfer.id %>">
  <div class="flex items-center gap-x-4">
    <div class="h-10 w-10 rounded-full flex items-center justify-center font-bold text-sm <%= is_debit ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20' : 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' %>">
      <%= is_debit ? "&uarr;".html_safe : "&darr;".html_safe %>
    </div>
    <div>
      <p class="text-sm font-semibold text-white">
        <% if is_debit %>
          Sent to <span class="font-mono text-xs text-sky-400"><%= transfer.to_account.account_number %></span> (<%= transfer.to_account.user.full_name %>)
        <% else %>
          Received from <span class="font-mono text-xs text-sky-400"><%= transfer.from_account.account_number %></span> (<%= transfer.from_account.user.full_name %>)
        <% end %>
      </p>
      <p class="text-xs text-slate-400 mt-0.5">
        <%= transfer.description.presence || "Peer-to-peer transfer" %> &bull; <%= transfer.created_at.strftime("%b %d, %Y at %H:%M") %>
      </p>
    </div>
  </div>

  <div class="text-right">
    <p class="text-base font-bold <%= is_debit ? 'text-rose-400' : 'text-emerald-400' %>">
      <%= is_debit ? "- " : "+ " %><%= transfer.formatted_amount %>
    </p>
    <p class="text-xs text-slate-500 font-mono">
      <%= transfer.idempotency_key ? "ID: #{transfer.idempotency_key.truncate(14)}" : "TX-#{transfer.id}" %>
    </p>
  </div>
</li>
