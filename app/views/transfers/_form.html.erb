<%= form_with url: transfers_path, scope: :transfer, class: "space-y-5" do |f| %>
  <%= f.hidden_field :from_account_id, value: from_account.id %>
  <%= f.hidden_field :idempotency_key, value: SecureRandom.uuid %>

  <div>
    <%= f.label :to_account_number, "Recipient Account Number", class: "block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2" %>
    <%= f.text_field :to_account_number, required: true, placeholder: "e.g. FX-200001", class: "w-full rounded-lg bg-slate-800 border border-slate-700 px-4 py-2.5 text-white placeholder-slate-500 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none text-sm font-mono" %>
    <p class="mt-1 text-xs text-slate-500">Destination must be an active FxBank account number.</p>
  </div>

  <div data-controller="currency-input">
    <div class="flex items-center justify-between mb-2">
      <%= f.label :amount_dollars, "Transfer Amount ($ USD)", class: "block text-xs font-semibold uppercase tracking-wider text-slate-300" %>
      <span data-currency-input-target="preview" class="text-xs font-semibold text-sky-400 font-mono">$0.00 USD</span>
    </div>
    <%= f.number_field :amount_dollars, step: "0.01", min: "0.01", required: true, placeholder: "0.00", data: { currency_input_target: "input", action: "input->currency-input#updatePreview" }, class: "w-full rounded-lg bg-slate-800 border border-slate-700 px-4 py-2.5 text-white placeholder-slate-500 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none text-sm font-mono" %>
  </div>

  <div>
    <%= f.label :description, "Memo / Note (Optional)", class: "block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2" %>
    <%= f.text_field :description, placeholder: "What is this transfer for?", class: "w-full rounded-lg bg-slate-800 border border-slate-700 px-4 py-2.5 text-white placeholder-slate-500 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none text-sm" %>
  </div>

  <div class="pt-2 flex items-center justify-end gap-x-3">
    <button type="button" data-action="click->modal#close" class="rounded-lg px-4 py-2.5 text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">
      Cancel
    </button>
    <%= f.submit "Authorize & Send", data: { turbo_submits_with: "Processing Transfer..." }, class: "cursor-pointer rounded-lg bg-sky-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-sky-400 shadow-md transition-colors" %>
  </div>
<% end %>
