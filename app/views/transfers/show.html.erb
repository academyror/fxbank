<div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-12">
  <div class="mb-6">
    <%= link_to "&larr; Back to Account".html_safe, account_path(@transfer.from_account), class: "text-sm text-slate-400 hover:text-white" %>
  </div>

  <div class="rounded-2xl bg-slate-800/80 border border-slate-700 p-8 shadow-2xl">
    <div class="text-center border-b border-slate-700/60 pb-6 mb-6">
      <div class="mx-auto h-12 w-12 rounded-full bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl font-bold mb-3 border border-emerald-500/20">
        &check;
      </div>
      <h1 class="text-2xl font-bold text-white">Transfer Completed</h1>
      <p class="text-3xl font-extrabold text-emerald-400 mt-2"><%= @transfer.formatted_amount %></p>
      <p class="text-xs text-slate-400 mt-1"><%= @transfer.created_at.strftime("%B %d, %Y at %H:%M:%S UTC") %></p>
    </div>

    <dl class="space-y-4 text-sm">
      <div class="flex justify-between">
        <dt class="text-slate-400">Sender Account</dt>
        <dd class="font-mono text-white"><%= @transfer.from_account.account_number %> (<%= @transfer.from_account.user.full_name %>)</dd>
      </div>

      <div class="flex justify-between">
        <dt class="text-slate-400">Recipient Account</dt>
        <dd class="font-mono text-white"><%= @transfer.to_account.account_number %> (<%= @transfer.to_account.user.full_name %>)</dd>
      </div>

      <div class="flex justify-between">
        <dt class="text-slate-400">Memo</dt>
        <dd class="text-white"><%= @transfer.description.presence || "None" %></dd>
      </div>

      <div class="flex justify-between">
        <dt class="text-slate-400">Status</dt>
        <dd class="text-emerald-400 font-semibold uppercase"><%= @transfer.status %></dd>
      </div>

      <div class="flex justify-between border-t border-slate-700/60 pt-4">
        <dt class="text-slate-400">Idempotency Reference</dt>
        <dd class="font-mono text-xs text-slate-300"><%= @transfer.idempotency_key %></dd>
      </div>
    </dl>
  </div>
</div>
